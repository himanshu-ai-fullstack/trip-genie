# Claude (needed for the real agent; without it set GENIE_OFFLINE=1)
ANTHROPIC_API_KEY=

# Run the scripted offline agent instead of Claude (demo and tests)
GENIE_OFFLINE=0

# Optional estimated Claude token rates per million tokens; review against your provider pricing.
GENIE_SONNET_INPUT_USD_PER_MILLION=3
GENIE_SONNET_OUTPUT_USD_PER_MILLION=15
GENIE_OPUS_INPUT_USD_PER_MILLION=15
GENIE_OPUS_OUTPUT_USD_PER_MILLION=75

# Storage. Leave empty to use in-memory stores.
DATABASE_URL=
REDIS_URL=

# Admin token for the kill switch endpoint
ADMIN_TOKEN=change-me

# Optional: Voyage AI embeddings. Without it a local hashed embedding is used.
VOYAGE_API_KEY=

# Provider keys. Empty means the mock adapters are used.
GOOGLE_PLACES_API_KEY=
TICKETMASTER_API_KEY=
GETYOURGUIDE_API_KEY=
